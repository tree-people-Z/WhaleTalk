# .gitignore - Git版本控制忽略文件

# 本地运行数据（包含密钥、登录凭证、历史记录和个人日记）
data/*
!data/.gitkeep
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal

# 临时登录二维码与本地工具设置
qrcode.png
.claude/

# Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 虚拟环境
venv/
.venv/
env/
ENV/

# 环境变量密钥文件
.env
.env.*
!.env.example

# IDE设置
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# 临时文件
*.tmp
*.bak
*.log

# 分发文件
build/
dist/
*.egg-info/

# 测试与工具缓存
.pytest_cache/
.coverage
htmlcov/
